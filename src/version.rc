#include <windows.h>

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenRGB Community\0"
            VALUE "FileDescription",  "OpenRGB Flowers Blooming & Redragon RGB Native Controller\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "FlowersBlooming\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 OpenRGB Community Contributors\0"
            VALUE "OriginalFilename", "FlowersBlooming.exe\0"
            VALUE "ProductName",      "OpenRGB Flowers Blooming\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
